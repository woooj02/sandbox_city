{
  "name": "sandbox-city",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "npm run dev -w @sandbox-city/web",
    "server": "npm run start -w @sandbox-city/server",
    "build": "npm run build -w @sandbox-city/web",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p packages/server && tsc -p packages/web"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "tsx": "^4.23.15",
    "@types/node": "^22.10.0"
  }
}
