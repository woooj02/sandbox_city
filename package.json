{
  "name": "sandbox-city",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @sandbox-city/web",
    "server": "npm run start -w @sandbox-city/server",
    "build": "npm run build -w @sandbox-city/web",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p packages/server && tsc -p packages/web",
    "claims": "tsx scripts/verify-claims.ts",
    "agent-test": "tsx scripts/regress.ts regressions --kind=agent --agent",
    "verify": "npm run typecheck && npm test && npm run claims && npm run build"
  },
  "devDependencies": {
    "@paypal/agent-toolkit": "1.11.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
