# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Comma-separated sandbox business accounts that receive payments (round-robin across city stores)
PAYPAL_PAYEE_EMAILS=
# Sandbox test card used by agents for server-side card payments
PAYPAL_TEST_CARD=
PAYPAL_TEST_CARD_EXPIRY=2030-12
PAYPAL_TEST_CARD_CVV=123
# Share of non-hero orders routed to the live sandbox lane
LIVE_SAMPLE=0.02
PORT=8787
